# Copy to .env. Never commit .env.

# 1: run with no model keys. Detection and Meena are scripted; Kane CLI still runs for real.
OFFLINE_MODE=0

# Models, served by Cerebras (OpenAI-compatible API). Required unless OFFLINE_MODE=1.
CEREBRAS_API_KEY=
PERSONA_MODEL=gpt-oss-120b
FLAG_MODEL=qwen-3.8-27b
# Requests per minute allowed per model on your Cerebras plan.
CEREBRAS_RPM_OSS=5
CEREBRAS_RPM_QWEN=5

# OpenAI (optional): Decisions second opinion, moderation, report fallback and the live voice on phone calls.
OPENAI_API_KEY=
DECISIONS_MODEL=gpt-6-luna
LIVE_MODEL=gpt-live-1

# Phone calls (Twilio). Point the number's voice webhook at PUBLIC_BASE_URL/voice/incoming.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
CALL_BATCH_SECONDS=20

# Storage
DB_PATH=scambait.db
DATA_DIR=out

# Public https address of this server (Telegram webhook, links on deployed hosts).
PUBLIC_BASE_URL=
# If set, POST /api/investigations needs this value in the x-api-key header.
API_KEY=

# Telegram bot. TELEGRAM_AUTO_WEBHOOK=0 on any copy that must not take the bot from the live server.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTO_WEBHOOK=1

# Browser scam console
CONSOLE_ENABLED=1

# Kane investigator: Kane CLI opens scam links in a real browser. Run `kane-cli login` once first.
KANE_ENABLED=1
KANE_CMD=kane-cli
KANE_TIMEOUT_S=240
KANE_MAX_STEPS=40
KANE_HEADLESS=1
KANE_WORKDIR=out/kane
# Optional basic auth for hosts where `kane-cli login` cannot open a browser.
KANE_USERNAME=
KANE_ACCESS_KEY=
# 0 (default): only practice-lab links (/lab/...) are opened. 1: real links too, under the safety rules.
LIVE_INVESTIGATION=0

# Render deploy hook, called by `make ship` only after every Kane test passes.
RENDER_DEPLOY_HOOK=
